{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "genova.vr/1",
  "title": "Genova VR bundle manifest",
  "type": "object",
  "required": [
    "schema",
    "title",
    "language",
    "scenes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "genova.vr/1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "summary": {
      "type": "string",
      "maxLength": 600
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "tracks": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "prompt": {
            "type": "string",
            "maxLength": 400
          },
          "audio": {
            "type": "string"
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.4
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "id",
          "brief"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "brief": {
            "type": "string",
            "maxLength": 700
          },
          "file": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        }
      }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "color": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 3,
      "maxItems": 4
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,40}$"
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "title",
        "nodes",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "sky": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "$ref": "#/$defs/color"
            },
            "texture": {
              "type": "string"
            },
            "style": {
              "enum": [
                "stars",
                "plain"
              ]
            }
          }
        },
        "nodes": {
          "type": "array",
          "maxItems": 80,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "quiz": {
          "$ref": "#/$defs/quiz"
        },
        "ambience": {
          "$ref": "#/$defs/ambience"
        },
        "music": {
          "type": "string",
          "description": "id of a track in `tracks`, or \"none\" to fade the music out; omitted = keep what is playing"
        },
        "fog": {
          "$ref": "#/$defs/fog"
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "sphere",
            "disc",
            "quad",
            "box",
            "cylinder",
            "cone",
            "torus",
            "model",
            "emitter",
            "light",
            "effect"
          ]
        },
        "pos": {
          "$ref": "#/$defs/vec3"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "texture": {
          "type": "string"
        },
        "lit": {
          "type": "boolean"
        },
        "parent": {
          "$ref": "#/$defs/id"
        },
        "orbit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "radius": {
              "type": "number",
              "minimum": 0,
              "maximum": 200
            },
            "speed": {
              "type": "number"
            },
            "phase": {
              "type": "number"
            }
          }
        },
        "spin": {
          "type": "number"
        },
        "tilt": {
          "type": "number"
        },
        "inner": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.999
        },
        "label": {
          "type": "string",
          "maxLength": 60
        },
        "billboard": {
          "type": "boolean"
        },
        "pickable": {
          "type": "boolean"
        },
        "light": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/light"
            }
          ]
        },
        "model": {
          "type": "string",
          "description": "bundle-relative .glb path (filled in by the pipeline)"
        },
        "asset": {
          "$ref": "#/$defs/id"
        },
        "rot": {
          "$ref": "#/$defs/vec3"
        },
        "stretch": {
          "$ref": "#/$defs/vec3"
        },
        "visible": {
          "type": "boolean"
        },
        "animate": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/track"
          }
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "emitter": {
          "$ref": "#/$defs/emitter"
        },
        "effect": {
          "enum": [
            "explosion",
            "campfire"
          ]
        },
        "effect_group": {
          "type": "boolean"
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "audio": {
          "type": "string"
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "highlight": {
          "$ref": "#/$defs/id"
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pos": {
              "$ref": "#/$defs/vec3"
            },
            "focus": {
              "$ref": "#/$defs/id"
            },
            "follow": {
              "$ref": "#/$defs/id"
            },
            "seconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "sfx": {
          "$ref": "#/$defs/sfx"
        },
        "set": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/setop"
          }
        },
        "show": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "hide": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "cues": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/cue"
          }
        },
        "burst": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "feedback": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 300
        },
        "audio": {
          "type": "string"
        },
        "duration": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "quiz": {
      "type": "object",
      "required": [
        "question",
        "options"
      ],
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "string",
          "maxLength": 300
        },
        "audio": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 40
              },
              "correct": {
                "type": "boolean"
              }
            }
          }
        },
        "correct": {
          "$ref": "#/$defs/feedback"
        },
        "wrong": {
          "$ref": "#/$defs/feedback"
        },
        "duration": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "sfx": {
      "type": "object",
      "required": [
        "prompt"
      ],
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "type": "string",
          "maxLength": 200
        },
        "audio": {
          "type": "string"
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "delay": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "ambience": {
      "type": "object",
      "required": [
        "prompt"
      ],
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "type": "string",
          "maxLength": 200
        },
        "audio": {
          "type": "string"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        }
      }
    },
    "numOrVec": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/vec3"
        }
      ]
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prop",
        "to"
      ],
      "properties": {
        "prop": {
          "enum": [
            "position",
            "scale",
            "rotation",
            "opacity"
          ]
        },
        "from": {
          "$ref": "#/$defs/numOrVec"
        },
        "to": {
          "$ref": "#/$defs/numOrVec"
        },
        "seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "loop": {
          "enum": [
            "once",
            "loop",
            "pingpong"
          ]
        },
        "ease": {
          "enum": [
            "linear",
            "smooth"
          ]
        },
        "delay": {
          "type": "number",
          "minimum": 0,
          "maximum": 120
        }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "points"
      ],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/vec3"
          }
        },
        "seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "loop": {
          "enum": [
            "once",
            "loop",
            "pingpong"
          ]
        },
        "phase": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "setop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node"
      ],
      "properties": {
        "node": {
          "$ref": "#/$defs/id"
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        }
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phrase": {
          "type": "string",
          "maxLength": 60
        },
        "at": {
          "type": "number",
          "minimum": 0,
          "maximum": 120
        },
        "highlight": {
          "$ref": "#/$defs/id"
        },
        "show": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "hide": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "set": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/setop"
          }
        },
        "burst": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "rgb": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 3,
      "maxItems": 4
    },
    "fog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "$ref": "#/$defs/rgb"
        },
        "density": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "base": {
          "type": "number"
        },
        "falloff": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "emitter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "enum": [
            "sparks",
            "fire",
            "smoke",
            "steam",
            "dust",
            "explosion",
            "rain",
            "snow",
            "bubbles",
            "magic",
            "mist"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400
        },
        "life": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 30
        },
        "speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "gravity": {
          "type": "number",
          "minimum": -30,
          "maximum": 30
        },
        "drag": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "spread": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "dir": {
          "$ref": "#/$defs/vec3"
        },
        "shape": {
          "enum": [
            "point",
            "sphere",
            "box",
            "disc",
            "line"
          ]
        },
        "extent": {
          "$ref": "#/$defs/vec3"
        },
        "size": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "minItems": 2,
          "maxItems": 2
        },
        "color_start": {
          "$ref": "#/$defs/rgb"
        },
        "color_end": {
          "$ref": "#/$defs/rgb"
        },
        "blend": {
          "enum": [
            "additive",
            "alpha"
          ]
        },
        "loop": {
          "type": "boolean"
        },
        "texture": {
          "enum": [
            "soft",
            "spark",
            "smoke",
            "ring",
            "star"
          ]
        }
      }
    },
    "light": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "enum": [
            "candle",
            "torch",
            "lamp",
            "spotlight",
            "moonlight",
            "alarm"
          ]
        },
        "type": {
          "enum": [
            "point",
            "spot"
          ]
        },
        "color": {
          "$ref": "#/$defs/rgb"
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "range": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 60
        },
        "angle": {
          "type": "number",
          "minimum": 5,
          "maximum": 80
        },
        "softness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dir": {
          "$ref": "#/$defs/vec3"
        },
        "aim": {
          "$ref": "#/$defs/id"
        },
        "flicker": {
          "enum": [
            "none",
            "candle",
            "pulse",
            "strobe",
            "flash"
          ]
        },
        "beam": {
          "type": "boolean"
        }
      }
    }
  }
}