# Copy this file to server/.env and fill in your own values.
# server/.env is git-ignored. Never paste real keys into any other file.

# --- Language model (required to generate experiences) ---
# Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any OpenRouter model id. Leave empty to use the model named in builder/agents/*.json.
GENOVA_LLM_MODEL=openai/gpt-6.1-sol

# --- Optional media providers ---
# Sound effects and ambience (ElevenLabs)
ELEVEN_API_KEY=
# Background music (Google Lyria)
GEMINI_API_KEY=

# --- Narration (Kokoro-82M, local, no key) ---
# Only needed on macOS when espeak-ng data is not found automatically.
# Example: /opt/homebrew/share/espeak-ng-data
ESPEAK_DATA_PATH=

# --- Server ---
GENOVA_VR_DATA=./data
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Generate with: python3 -c "from werkzeug.security import generate_password_hash as h; print(h('your-password'))"
ADMIN_USER=genova
ADMIN_PASSWORD_HASH=
COOKIE_SECURE=0
