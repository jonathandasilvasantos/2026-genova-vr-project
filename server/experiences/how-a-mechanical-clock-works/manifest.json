{
  "schema": "genova.vr/1",
  "title": "Inside a Mechanical Clock",
  "language": "en",
  "summary": "Explore a weight-driven pendulum clock to discover how stored energy, gears, and a ticking escapement work together. Follow the motion to the clock hands, investigate what keeps the clock accurate, and finish with a short quiz.",
  "assets": [
    {
      "id": "clock_weight_and_drum",
      "brief": "A weight-driven clock power assembly with a tall brass cylindrical weight, cream cord, horizontal winding drum, and steel axle in a small support frame. Use clean, accurate surfaces and realistic proportions: the weight is about three times taller than wide. The drum rotates as cord unwinds, lowering the weight vertically; its axle supplies rotation to the gear train.",
      "file": "models/clock_weight_and_drum.glb"
    },
    {
      "id": "clock_going_train",
      "brief": "An exposed clock gear train with several brass toothed wheels, smaller steel pinions fixed to their shafts, and two narrow support plates. Wheels stand vertically with horizontal axles facing the viewer. Use clean, accurate teeth and realistic varying diameters. Meshing wheels turn oppositely; wheel-and-pinion pairs share rotation. Animate linked motion from a slow input through a once-per-hour shaft to a faster escapement output.",
      "file": "models/clock_going_train.glb"
    },
    {
      "id": "clock_anchor_escapement",
      "brief": "A mechanical anchor escapement with a brass escape wheel, steel anchor, two clearly shaped pallet faces, pivot, and pendulum coupling. The wheel stands vertically, its axle pointing toward the viewer, with the anchor above it. Use clean, accurate proportions and visible teeth. The anchor rocks, alternately locking and releasing teeth; brief contact impulses sustain the pendulum, while the wheel advances in small steps.",
      "file": "models/clock_anchor_escapement.glb"
    },
    {
      "id": "clock_adjustable_pendulum",
      "brief": "A clock pendulum with a slender steel rod, round brass bob, top suspension, and threaded adjustment nut beneath the bob. Hang it vertically, front facing the viewer, with roughly one metre from suspension to bob centre. Use clean, realistic surfaces and a small swing angle. The pendulum swings side to side; turning the nut raises or lowers the bob along the rod.",
      "file": "models/clock_adjustable_pendulum.glb"
    },
    {
      "id": "clock_dial_and_motion_works",
      "brief": "A cream circular clock dial with dark numerals 1–12, black minute and hour hands, concentric shafts, and exposed brass motion-work gears behind it. Face the dial forward. A 12-tooth minute pinion drives a 36-tooth offset gear sharing a shaft with a 10-tooth pinion, which drives a 40-tooth hour gear. Animate both hands clockwise, with the shorter hour hand turning twelve times slower.",
      "file": "models/clock_dial_and_motion_works.glb"
    }
  ],
