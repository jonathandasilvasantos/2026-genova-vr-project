      "steps": [
        {
          "text": "A raised weight stores energy. Gravity pulls it down to power this clock, without a battery or motor. Parts are enlarged and spread out.",
          "highlight": "weight_assembly",
          "camera": {
            "pos": [
              0,
              1.6,
              0
