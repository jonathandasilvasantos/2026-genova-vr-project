                "gravity_arrow_stem",
                "gravity_arrow_tip"
              ],
              "at": 1.54
            }
          ],
          "audio": "audio/power_and_gears_00.wav",
          "duration": 7.28
        },
        {
          "text": "Motion is sped up. As the weight falls, its cord unwinds from the drum. The drum turns an axle that drives the gears.",
